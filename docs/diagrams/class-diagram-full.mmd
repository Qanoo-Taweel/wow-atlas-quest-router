%% ===================== Facade =====================
class AtlasQuestRouter {
  <<Facade>>
  -gameApi: IGameApi
  -questLog: QuestLog
  -planner: QuestRoutePlanner
  -resolver: LocationResolver
  -scheduler: IScheduler
  -commands: CommandHandler
  -interactions: Map~kind, IUserInteraction~
  -currentPlan: RoutePlan
  +addQuest(idOrName) Quest
  +removeQuest(id)
  +listQuests()
  +clearQuests()
  +importQuestLog() int
  +demo()
  +plan(onDone)
  +nextLeg() Leg
  +setStartOverride(text)
  +setRiding(text)
  +setBind(text)
  +previousLeg() Leg
  +onQuestAccepted(title)
  +onQuestTurnedIn(title)
  +onObjectivesComplete(title)
  +onArrived(place)
  +setGuideVisible(bool)
  +runCommand(input)
  +save() table
  +load(saved)
  +say(message)
}

%% ===================== Commands (Command + Chain of Responsibility) =====================
class CommandHandler {
  <<abstract>>
  +verbs: string[]
  +usage: string
  -nextHandler: CommandHandler
  +setNext(handler) CommandHandler
  +canHandle(verb) bool
  +handle(verb, args, router)
  +execute(args, router)*
}
class HelpCommand
class AddCommand
class PlanCommand
class NextCommand
class BackCommand
class ImportCommand
class UnknownCommand
class CommandChain {
  <<utility>>
  +default()$ CommandHandler
  +parse(input)$ verb, args
}
CommandHandler <|-- HelpCommand
CommandHandler <|-- AddCommand
CommandHandler <|-- PlanCommand
CommandHandler <|-- NextCommand
CommandHandler <|-- BackCommand
CommandHandler <|-- ImportCommand
CommandHandler <|-- UnknownCommand
CommandHandler --> CommandHandler : next
CommandChain ..> CommandHandler : builds
AtlasQuestRouter o-- CommandHandler

