%% ===================== Routing (Builder) =====================
class QuestRoutePlanner {
  <<Service>>
  -builder: WorldGraphBuilder
  -solverFactory: AtlasSolverFactory
  +plan(profile, quests, start, options) RoutePlan
  +toLegs(model, tour) Leg[]
  +describe(plan) string[]
}
class WorldGraphBuilder {
  <<Builder>>
  -linkFactory: TravelLinkFactory
  -accessChain: AccessRule
  +reset(profile) self
  +addLocations() self
  +addWalkingNetwork() self
  +addFlightNetwork() self
  +addTransports() self
  +addTeleports() self
  +addHearthstone() self
  +addQuestSteps(quests) self
  +setStart(location) self
  +result() WorldModel
}
class EdgeGate {
  -closedTokens: Set
  +allows(label) bool
  +token(label) string
  +onTraverse(label)
}
class LocationResolver {
  +byText(text) id
  +fromGame(subzone, zone) id
  +exactSubzone(subzone) id
}
